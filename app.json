{
  "expo": {
    "name": "Pimkart",
    "description": "Online shopping site in India: Shop online for Fashion, Dresses, Gift items and More - Pimkart",
    "slug": "gb-ecomm-app",
    "version": "1.0.0",
    "scheme": "gbecomm",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.geekbaselab.gbecommapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd46cab1-89c5-4230-92f9-c2db6ec89b72"
      }
    }
  }
}
